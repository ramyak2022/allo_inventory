# Copy this to .env.local and fill in your values

# Postgres — use Supabase, Neon, or Railway (hosted, not local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Redis — use Upstash or Redis Cloud (optional but recommended for production)
REDIS_URL="redis://default:password@host:6379"

# Cron security — set any random string and pass it as Bearer token in cron config
CRON_SECRET="your-random-secret-here"
